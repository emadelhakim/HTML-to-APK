    function calculateAndRenderProfits() {
      const devicesProfit = salesData.reduce((sum, item) => sum + (parseFloat(item.sellPrice || 0) - parseFloat(item.buyPrice || 0)), 0);
      const accProfit = accSalesData.reduce((sum, item) => sum + ((parseFloat(item.sellPrice || 0) - parseFloat(item.buyPrice || 0)) * parseInt(item.qty || 1)), 0);
      const maintProfit = maintenanceData.reduce((sum, item) => sum + (parseFloat(item.sellPrice || 0) - parseFloat(item.buyPrice || 0)), 0);
      const totalExpenses = expensesData.reduce((sum, exp) => sum + parseFloat(exp.amount || 0), 0);

      const grossProfit = devicesProfit + accProfit + maintProfit;
      const netProfit = grossProfit - totalExpenses;

      document.getElementById('profitDevicesTotal').innerText = devicesProfit.toLocaleString() + ' ج.م';
      document.getElementById('profitAccTotal').innerText = accProfit.toLocaleString() + ' ج.م';
      document.getElementById('profitMaintTotal').innerText = maintProfit.toLocaleString() + ' ج.م';
      document.getElementById('netProfitTotal').innerText = netProfit.toLocaleString() + ' ج.م';

      const tbody = document.getElementById('profitsTableBody');
      tbody.innerHTML = '';
      let index = 1;

      salesData.forEach(item => {
        const profit = parseFloat(item.sellPrice || 0) - parseFloat(item.buyPrice || 0);
        const profitDisplay = isProfitHidden ? '***' : profit + ' ج.م';
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${index++}</td>
          <td>${item.item}</td>
          <td>${item.storage ? item.storage + 'G' : '-'}</td>
          <td>${item.ram ? item.ram + 'G' : '-'}</td>
          <td>${item.buyPrice}</td>
          <td>${item.sellPrice}</td>
          <td class="profit-cell" onclick="toggleProfitVisibility()">${profitDisplay}</td>
          <td>${item.serial}</td>
          <td style="color:var(--main-icon-color);">مبيعات جهاز</td>
        `;
        tbody.appendChild(row);
      });

      accSalesData.forEach(item => {
        const profit = (parseFloat(item.sellPrice || 0) - parseFloat(item.buyPrice || 0)) * parseInt(item.qty || 1);
        const profitDisplay = isProfitHidden ? '***' : profit + ' ج.م';
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${index++}</td>
          <td>${item.item} (كمية: ${item.qty || 1})</td>
          <td>-</td>
          <td>-</td>
          <td>${item.buyPrice}</td>
          <td>${item.sellPrice}</td>
          <td class="profit-cell" onclick="toggleProfitVisibility()">${profitDisplay}</td>
          <td>${item.serial || '-'}</td>
          <td style="color:#ffeb3b;">مبيعات إكسسوار</td>
        `;
        tbody.appendChild(row);
      });

      maintenanceData.forEach(item => {
        const profit = parseFloat(item.sellPrice || 0) - parseFloat(item.buyPrice || 0);
        const profitDisplay = isProfitHidden ? '***' : profit + ' ج.م';
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${index++}</td>
          <td>${item.item}</td>
          <td>-</td>
          <td>-</td>
          <td>${item.buyPrice}</td>
          <td>${item.sellPrice}</td>
          <td class="profit-cell" onclick="toggleProfitVisibility()">${profitDisplay}</td>
          <td>${item.serial}</td>
          <td style="color:#0088cc;">صيانة جهاز</td>
        `;
        tbody.appendChild(row);
      });
    }

