    function importDataBackup(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);

          if (imported.devicesDataList) { devicesData = imported.devicesDataList; localStorage.setItem('devicesDataList', JSON.stringify(devicesData)); }
          if (imported.salesDataList) { salesData = imported.salesDataList; localStorage.setItem('salesDataList', JSON.stringify(salesData)); }
          if (imported.accPurchasesDataList) { accPurchasesData = imported.accPurchasesDataList; localStorage.setItem('accPurchasesDataList', JSON.stringify(accPurchasesData)); }
          if (imported.accSalesDataList) { accSalesData = imported.accSalesDataList; localStorage.setItem('accSalesDataList', JSON.stringify(accSalesData)); }
          if (imported.expensesDataList) { expensesData = imported.expensesDataList; localStorage.setItem('expensesDataList', JSON.stringify(expensesData)); }
          if (imported.maintenanceDataList) { maintenanceData = imported.maintenanceDataList; localStorage.setItem('maintenanceDataList', JSON.stringify(maintenanceData)); }
          if (imported.salesNotebookDataList) { salesNotebookData = imported.salesNotebookDataList; localStorage.setItem('salesNotebookDataList', JSON.stringify(salesNotebookData)); }
          if (imported.employeesDataList) { employeesData = imported.employeesDataList; localStorage.setItem('employeesDataList', JSON.stringify(employeesData)); }

          refreshAllTablesAndViews();
          syncChannel.postMessage({ type: 'SYNC_SUCCESS' });

          alert('تمت استعادة النسخة الاحتياطية بنجاح بنسبة 100%!');
          closeBackupModal();
        } catch (err) {
