    function generateMessageText() {
      let text = `سنترال الحكيم\n`;
      text += `العملية: ${currentData.opType}\n`;
      text += `الصنف: ${currentData.item}\n`;
      if (currentData.isAcc) {
        text += `الكمية: ${currentData.qty}\n`;
        text += `السيريال: ${currentData.serial}\n`;
      } else if (currentData.isMaint) {
        text += `السيريال: ${currentData.serial}\n`;
        text += `حالة الصيانة: ${currentData.opType}\n`;
        text += `المدفوع: ${currentData.paidPrice} ج.م\n`;
        text += `المتبقي: ${currentData.remainingPrice} ج.م\n`;
      } else {
        text += `السيريال: ${currentData.serial}\n`;
      }
      text += `السعر: ${currentData.sellPrice} ج.م\n`;
      text += `التاريخ: ${currentData.dateTime}\n`;
      text += `المورد/العميل: ${currentData.supplier}`;
      
      document.getElementById('messagePreview').innerText = text;
      updateMessageLinks();
    }

    function updateMessageLinks() {
      const phone = document.getElementById('customerPhone').value.trim();
      const cleanPhone = phone.startsWith('01') ? '+2' + phone : phone;
      const msg = encodeURIComponent(document.getElementById('messagePreview').innerText);
      
      document.getElementById('whatsappBtn').href = phone ? `https://wa.me/${cleanPhone}?text=${msg}` : `#`;
      document.getElementById('smsBtn').href = phone ? `sms:${phone}?body=${msg}` : `#`;
    }

    function pickContact() {
      if ('contacts' in navigator && 'ContactsManager' in window) {
        navigator.contacts.select(['tel'], { multiple: false })
          .then(contacts => {
            if (contacts.length && contacts[0].tel.length) {
              const num = contacts[0].tel[0].replace(/\s+/g, '');
              document.getElementById('customerPhone').value = num;
              localStorage.setItem('lastAutoTargetPhone', num);
              updateMessageLinks();
            }
          })
          .catch(() => alert('تعذر الوصول إلى قائمة الأسماء.'));
      } else {
        alert('ميزة اختيار الأسماء غير مدعومة مباشرة من المتصفح، أدخل الرقم يدوياً.');
      }
    }

