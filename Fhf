    function executeProMessageSending() {
      const messageText = document.getElementById('proMessageContent').value.trim();
      const specificPhones = document.getElementById('specificTargetPhones').value.trim();
      const targetGroup = document.getElementById('targetGroupSelect').value;

      let recipients = specificPhones.split(/[,,\n]/).map(p => p.trim()).filter(Boolean);

      if (recipients.length === 0 && targetGroup !== 'specific_target') {
        loadSavedNumbersIntoBox();
        recipients = document.getElementById('specificTargetPhones').value.split(/[,,\n]/).map(p => p.trim()).filter(Boolean);
      }

      if (recipients.length === 0) {
        showToast('يرجى إدخال رقم واحد على الأقل أو الاختيار من جهات الاتصال!', true);
        return;
      }

      localStorage.setItem('savedProTargetPhones', recipients.join(', '));
      const logBox = document.getElementById('deliveryReceiptItems');
      logBox.innerHTML = '';

      const encodedMsg = encodeURIComponent(messageText);
      const channelLabel = selectedSendChannel === 'whatsapp' ? 'واتساب' : selectedSendChannel === 'sms' ? 'SMS' : 'واتساب + SMS معاً';

      recipients.forEach((phone, idx) => {
        const cleanPhone = phone.startsWith('01') ? '+2' + phone : phone;
        
        // تنفيذ الإرسال حسب القناة المحددة
        if (idx === 0) {
          if (selectedSendChannel === 'whatsapp') {
            window.open(`https://wa.me/${cleanPhone}?text=${encodedMsg}`, '_blank');
          } else if (selectedSendChannel === 'sms') {
            window.location.href = `sms:${phone}?body=${encodedMsg}`;
          } else if (selectedSendChannel === 'both') {
            window.open(`https://wa.me/${cleanPhone}?text=${encodedMsg}`, '_blank');
            setTimeout(() => {
              window.location.href = `sms:${phone}?body=${encodedMsg}`;
            }, 900);
          }
        }

        // إشعار وصول الرسالة والمشاهدة للأرقام المحددة
        setTimeout(() => {
          const timeNow = new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          const itemLine = document.createElement('div');
          itemLine.style.padding = '5px 0';
          itemLine.style.borderBottom = '1px solid #1e293b';
          itemLine.innerHTML = `<span style="color:#00e676; font-weight:bold;">✓✓ تم الوصول والمشاهدة</span> | الرقم: <strong style="color:#ffeb3b;">${phone}</strong> | عبر: (${channelLabel}) - الساعة ${timeNow}`;
          logBox.prepend(itemLine);

          if (idx === recipients.length - 1) {
            playBeepSound();
            showToast(`إشعار وصول ومشاهدة ✓✓: وصلت الرسالة وشوهدت بنجاح لـ (${recipients.length}) رقم عبر ${channelLabel}!`);
          }
        }, (idx + 1) * 700);
      });
    }

