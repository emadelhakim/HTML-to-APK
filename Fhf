    function checkBarcodeExistence(barcodeVal, type) {
      if (!barcodeVal || barcodeVal.trim() === '') return;
      const cleanCode = barcodeVal.trim();

      if (type === 'mobile') {
        const opType = document.getElementById('operationType').value;
        
        if (opType === 'بيع جهاز') {
          const foundDevice = devicesData.find(d => d.serial === cleanCode);
          if (foundDevice) {
            document.getElementById('itemName').value = foundDevice.item;
            document.getElementById('supplier').value = foundDevice.supplier;
            document.getElementById('storage').value = foundDevice.storage;
            document.getElementById('ram').value = foundDevice.ram;
            document.getElementById('buyPrice').value = foundDevice.buyPrice;
            document.getElementById('sellPrice').value = foundDevice.sellPrice;
            return;
          }
        }

        const allSerials = [...devicesData, ...salesData].map(d => d.serial);
        if (allSerials.includes(cleanCode) && opType !== 'بيع جهاز') {
          alert('تنبيه: تم إدخال هذا الباركود / السيريال من قبل، شكراً لكم');
          document.getElementById('serialNumber').value = '';
        }
      } else if (type === 'acc') {
        const opType = document.getElementById('accOpType').value;

        if (opType === 'بيع إكسسوار') {
          const foundAcc = accPurchasesData.find(a => a.serial === cleanCode);
          if (foundAcc) {
            document.getElementById('accItemName').value = foundAcc.item;
            document.getElementById('accSupplier').value = foundAcc.supplier;
            document.getElementById('accCategory').value = foundAcc.category || '';
            document.getElementById('accBuyPrice').value = foundAcc.buyPrice;
            document.getElementById('accSellPrice').value = foundAcc.sellPrice;
            return;
          }
        }

        const allAccCodes = [...accPurchasesData, ...accSalesData].map(a => a.serial);
        if (allAccCodes.includes(cleanCode) && opType !== 'بيع إكسسوار') {
          alert('تنبيه: تم إدخال هذا الباركود / السيريال من قبل، شكراً لكم');
          document.getElementById('accBarcode').value = '';
        }
      }
    }

    function handleOperationTypeChange(val) {
      const serialInput = document.getElementById('serialNumber').value;
      if (serialInput) checkBarcodeExistence(serialInput, 'mobile');
    }

    function handleAccOperationTypeChange(val) {
      const barcodeInput = document.getElementById('accBarcode').value;
