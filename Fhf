        alert('الرجاء إدخال رقم هاتف صحيح لإرسال الكود.');
        return;
      }
      
      generatedSyncCode = Math.floor(1000 + Math.random() * 9000).toString();
      const msg = encodeURIComponent(`كود مزامنة سنترال الحكيم الخاص بك هو: ${generatedSyncCode}`);
      const cleanPhone = phone.startsWith('+') ? phone : '+2' + phone;
      const waUrl = `https://wa.me/${cleanPhone}?text=${msg}`;
      
      const statusDiv = document.getElementById('syncCodeStatus');
      statusDiv.style.display = 'block';
      statusDiv.innerHTML = `
        <i class="fa-solid fa-circle-check"></i> تم توليد الكود بنجاح! كود التحقق: <strong>${generatedSyncCode}</strong><br>
        <a href="${waUrl}" target="_blank" class="btn-custom" style="margin-top:10px; background:#25d366; color:#000; display:inline-flex; text-decoration:none; justify-content:center; width:100%;">
          <i class="fa-brands fa-whatsapp"></i> إرسال الكود فوراً للموبايل الثاني عبر الواتساب
