    }

    let barcodeBuffer = "";
    let barcodeTimer = null;

    function handleExternalBarcode(event, inputId) {
      const inputElem = document.getElementById(inputId);
      if (!inputElem) return;

      if (event.key === 'Enter') {
        event.preventDefault();
        inputElem.dispatchEvent(new Event('input'));
        if (inputId === 'serialNumber') checkBarcodeExistence(inputElem.value, 'mobile');
        else if (inputId === 'accBarcode') checkBarcodeExistence(inputElem.value, 'acc');
        return;
      }

      if (event.key.length === 1) {
        barcodeBuffer += event.key;
        clearTimeout(barcodeTimer);
        barcodeTimer = setTimeout(() => {
          if (barcodeBuffer.length > 2) {
            inputElem.value = inputElem.value ? inputElem.value + barcodeBuffer : barcodeBuffer;
            inputElem.dispatchEvent(new Event('input'));
            playBeepSound();
          }
          barcodeBuffer = "";
        }, 100);
      }
    }

    function openUniversalScanner(targetInputId) {
      activeTargetInputId = targetInputId;
      const modal = document.getElementById('universalScannerModal');
      modal.style.display = 'flex';

      if (!codeReader) {
        codeReader = new ZXing.BrowserMultiFormatReader();
      }

      codeReader.listVideoInputDevices()
        .then((videoInputDevices) => {
          if (videoInputDevices.length === 0) {
            alert('لم يتم العثور على كاميرا متاحة في الجهاز.');
            closeUniversalScanner();
            return;
          }

          let selectedDeviceId = videoInputDevices[0].deviceId;
          for (let i = 0; i < videoInputDevices.length; i++) {
            const label = videoInputDevices[i].label.toLowerCase();
            if (label.includes('back') || label.includes('rear') || label.includes('خلفية') || label.includes('environment')) {
              selectedDeviceId = videoInputDevices[i].deviceId;
              break;
            }
          }

          const constraints = {
            video: {
              deviceId: selectedDeviceId ? { exact: selectedDeviceId } : undefined,
              width: { ideal: 1920, min: 1280 },
              height: { ideal: 1080, min: 720 },
              advanced: [{ focusMode: "continuous" }]
            }
          };

          codeReader.decodeFromConstraints(constraints, 'interactiveScannerVideo', (result, err) => {
            if (result) {
              playBeepSound();
              const decodedText = result.getText();
              const inputElem = document.getElementById(activeTargetInputId);
              if (inputElem) {
                inputElem.value = decodedText;
                inputElem.dispatchEvent(new Event('input'));
                if (activeTargetInputId === 'serialNumber') checkBarcodeExistence(decodedText, 'mobile');
                else if (activeTargetInputId === 'accBarcode') checkBarcodeExistence(decodedText, 'acc');
              }
              closeUniversalScanner();
            }
          });
        })
        .catch((err) => {
          console.error(err);
          try {
            codeReader.decodeFromVideoDevice(null, 'interactiveScannerVideo', (result, err) => {
              if (result) {
                playBeepSound();
                const decodedText = result.getText();
                const inputElem = document.getElementById(activeTargetInputId);
                if (inputElem) {
                  inputElem.value = decodedText;
                  inputElem.dispatchEvent(new Event('input'));
                  if (activeTargetInputId === 'serialNumber') checkBarcodeExistence(decodedText, 'mobile');
                  else if (activeTargetInputId === 'accBarcode') checkBarcodeExistence(decodedText, 'acc');
                }
                closeUniversalScanner();
              }
            });
          } catch (e) {
            alert('تعذر تشغيل الكاميرا. يرجى التأكد من إعطاء صلاحيات الكاميرا للمتصفح.');
            closeUniversalScanner();
          }
        });
    }

