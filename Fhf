    async function connectBluetoothPrinter() {
      try {
        if (!navigator.bluetooth) {
          alert('متصفحك لا يدعم تقنية البلوتوث (Web Bluetooth). يجدر استخدام متصفح Google Chrome المحدث.');
          return;
        }
        
        document.getElementById('btConnectionStatusText').innerText = 'جاري البحث عن طابعة بلوتوث...';
        
        bluetoothDevice = await navigator.bluetooth.requestDevice({
          acceptAllDevices: true,
          optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb', '0000ff00-0000-1000-8000-00805f9b34fb', 'e7810a71-73ae-499d-8c15-faa9aef0c3f2']
        });

        const server = await bluetoothDevice.gatt.connect();
        let service = null;
        const services = ['000018f0-0000-1000-8000-00805f9b34fb', '0000ff00-0000-1000-8000-00805f9b34fb', 'e7810a71-73ae-499d-8c15-faa9aef0c3f2'];
        
        for (const sUuid of services) {
          try {
            service = await server.getPrimaryService(sUuid);
            if (service) break;
          } catch(e) {}
        }

        if (!service) {
          const allServices = await server.getPrimaryServices();
          service = allServices[0];
        }

        const characteristics = await service.getCharacteristics();
        bluetoothCharacteristic = characteristics.find(c => c.properties.write || c.properties.writeWithoutResponse);

        if (!bluetoothCharacteristic) {
          throw new Error('خاصية الكتابة (Write Characteristic) غير موجودة في هذه الطابعة.');
        }

        document.getElementById('btConnectionStatusText').innerText = `متصل بـ: ${bluetoothDevice.name || 'طابعة بلوتوث'}`;
        alert(`تمت الاتصال بطابعة البلوتوث بنجاح: ${bluetoothDevice.name || 'طابعة حرارية'}`);
      } catch (error) {
        console.error(error);
        document.getElementById('btConnectionStatusText').innerText = 'بحث وتوصيل طابعة بلوتوث حرارية';
        alert('فشل الاتصال بالطابعة عبر البلوتوث: ' + error.message);
      }
    }

    async function printBluetoothThermalInvoice(elementId) {
      const previewDiv = document.getElementById(elementId);
      if (!previewDiv || previewDiv.innerText.includes('يرجى اختيار صنف')) {
        alert('الرجاء اختيار صنف أولاً للطباعة عبر البلوتوث.');
        return;
      }

      if (!bluetoothCharacteristic) {
        alert('يرجى توصيل طابعة البلوتوث أولاً من قسم (ضبط الطابعة والفواتير).');
        openPrinterSettingsScreen();
        return;
      }

      try {
        const textContent = previewDiv.innerText + '\n\n\n';
        const encoder = new TextEncoder('utf-8');
        const initCommand = new Uint8Array([0x1B, 0x40]);
        const cutCommand = new Uint8Array([0x1D, 0x56, 0x41, 0x03]);
        const textBytes = encoder.encode(textContent);

        const fullData = new Uint8Array(initCommand.length + textBytes.length + cutCommand.length);
        fullData.set(initCommand, 0);
        fullData.set(textBytes, initCommand.length);
        fullData.set(cutCommand, initCommand.length + textBytes.length);

        const chunkSize = 512;
        for (let i = 0; i < fullData.length; i += chunkSize) {
          const chunk = fullData.slice(i, i + chunkSize);
          if (bluetoothCharacteristic.properties.writeWithoutResponse) {
            await bluetoothCharacteristic.writeValueWithoutResponse(chunk);
          } else {
            await bluetoothCharacteristic.writeValue(chunk);
          }
        }

        alert('تم إرسال الفاتورة إلى طابعة البلوتوث بنجاح!');
      } catch (err) {
        console.error(err);
        alert('حدث خطأ أثناء الطباعة عبر البلوتوث: ' + err.message);
      }
    }

