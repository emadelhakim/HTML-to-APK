      const wb = XLSX.utils.table_to_book(document.getElementById('salesTable'), { sheet: "مبيعات الأجهزة" });
      XLSX.writeFile(wb, "مبيعات_الأجهزة.xlsx");
    }

    function renderAccPurchasesTable() {
      const tbody = document.getElementById('accPurchasesTableBody');
      tbody.innerHTML = '';
      if (accPurchasesData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" style="color: #aaa;">لا توجد مشتريات إكسسوارات حالياً</td></tr>`;
        return;
      }
      accPurchasesData.forEach((item, index) => {
        const profit = (item.sellPrice - item.buyPrice) * (item.qty || 1);
        const profitDisplay = isProfitHidden ? '***' : profit + ' ج.م';
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${index + 1}</td>
          <td>${item.item}</td>
          <td>${item.qty || 1}</td>
          <td>${item.buyPrice}</td>
          <td>${item.sellPrice}</td>
          <td class="profit-cell" onclick="toggleProfitVisibility()">${profitDisplay}</td>
          <td>${item.serial}</td>
          <td>${item.supplier}</td>
          <td>
            <i class="fa-solid fa-gear gear-icon" id="gear-acc-pur-${index}" onclick="openControlModal(${index}, 'accPurchases')" title="لوحة التحكم"></i>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function filterAccPurchasesTable() {
      const query = document.getElementById('searchInputAccPurchases').value.toLowerCase();
      document.querySelectorAll('#accPurchasesTableBody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(query) ? '' : 'none';
      });
    }

    function exportAccPurchasesToExcel() {
      const wb = XLSX.utils.table_to_book(document.getElementById('accPurchasesTable'), { sheet: "مشتريات الاكسسوارات" });
      XLSX.writeFile(wb, "مشتريات_الاكسسوارات.xlsx");
    }

    function renderAccSalesTable() {
      const tbody = document.getElementById('accSalesTableBody');
      tbody.innerHTML = '';
      if (accSalesData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" style="color: #aaa;">لا توجد مبيعات إكسسوارات حالياً</td></tr>`;
        return;
      }
      accSalesData.forEach((item, index) => {
        const profit = (item.sellPrice - item.buyPrice) * (item.qty || 1);
        const profitDisplay = isProfitHidden ? '***' : profit + ' ج.م';
        const row = document.createElement('tr');
        row.innerHTML = `
          <td>${index + 1}</td>
          <td>${item.item}</td>
          <td>${item.qty || 1}</td>
          <td>${item.buyPrice}</td>
          <td>${item.sellPrice}</td>
          <td class="profit-cell" onclick="toggleProfitVisibility()">${profitDisplay}</td>
          <td>${item.serial}</td>
          <td>${item.supplier}</td>
          <td>
            <i class="fa-solid fa-gear gear-icon" id="gear-acc-sal-${index}" onclick="openControlModal(${index}, 'accSales')" title="لوحة التحكم"></i>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function filterAccSalesTable() {
      const query = document.getElementById('searchInputAccSales').value.toLowerCase();
      document.querySelectorAll('#accSalesTableBody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(query) ? '' : 'none';
      });
    }

    function exportAccSalesToExcel() {
      const wb = XLSX.utils.table_to_book(document.getElementById('accSalesTable'), { sheet: "مبيعات الاكسسوارات" });
      XLSX.writeFile(wb, "مبيعات_الاكسسوارات.xlsx");
    }

    function toggleProfitVisibility() {
      isProfitHidden = !isProfitHidden;
      renderDevicesTable();
      renderSalesTable();
      renderAccPurchasesTable();
      renderAccSalesTable();
      renderMaintenanceTable();
      calculateAndRenderProfits();
    }

    function openControlModal(index, context) {
      activeDeviceIndex = index;
      activeContext = context;
      
      const modal = document.getElementById('controlModal');
      const title = document.getElementById('modalTitle');
      const transferBtn = document.getElementById('transferBtn');
      const maintStatusGroup = document.getElementById('maintStatusModalGroup');
      const maintExtraFields = document.getElementById('maintModalExtraFields');
      const notebookFields = document.getElementById('modalNotebookFields');
      const serialLabel = document.getElementById('modalSerialLabel');
      const directCallBtn = document.getElementById('modalDirectCallBtn');

      maintStatusGroup.style.display = 'none';
      maintExtraFields.style.display = 'none';
      notebookFields.style.display = 'none';
      directCallBtn.style.display = 'none';
      transferBtn.style.display = 'inline-block';

      const gearElem = document.getElementById(`gear-${context === 'purchases' ? 'dev' : context === 'sales' ? 'sale' : context === 'accPurchases' ? 'acc-pur' : context === 'accSales' ? 'acc-sal' : context === 'maintenance' ? 'maint' : 'nb'}-${index}`);
      if (gearElem) {
        gearElem.classList.add('spin');
        setTimeout(() => gearElem.classList.remove('spin'), 600);
      }

      let itemObj = null;
      if (context === 'purchases') {
        itemObj = devicesData[index];
        title.innerText = 'إدارة الجهاز';
        transferBtn.innerText = 'ترحيل للمبيعات';
      } else if (context === 'sales') {
        itemObj = salesData[index];
        title.innerText = 'إدارة الجهاز المباع';
        transferBtn.innerText = 'ترحيل للمشتريات';
      } else if (context === 'accPurchases') {
        itemObj = accPurchasesData[index];
        title.innerText = 'إدارة الإكسسوار';
        transferBtn.innerText = 'ترحيل للمبيعات';
      } else if (context === 'accSales') {
        itemObj = accSalesData[index];
        title.innerText = 'إدارة الإكسسوار المباع';
        transferBtn.innerText = 'ترحيل للمشتريات';
      } else if (context === 'maintenance') {
        itemObj = maintenanceData[index];
        title.innerText = 'إدارة سجل الصيانة';
        transferBtn.style.display = 'none';
        maintStatusGroup.style.display = 'block';
        maintExtraFields.style.display = 'flex';
        document.getElementById('modalMaintStatus').value = itemObj.status || 'تم استلام الجهاز';
        document.getElementById('modalPaid').value = itemObj.paidPrice || 0;
        document.getElementById('modalRemaining').value = itemObj.remainingPrice || 0;
      } else if (context === 'salesNotebook') {
        itemObj = salesNotebookData[index];
        title.innerText = 'إدارة كراسة المبيعات';
        transferBtn.style.display = 'none';
        notebookFields.style.display = 'block';
        document.getElementById('modalCustomerName').value = itemObj.customerName || '';
        document.getElementById('modalCustomerPhone').value = itemObj.customerPhone || '';
        if (itemObj.customerPhone) {
          directCallBtn.href = `tel:${itemObj.customerPhone}`;
          directCallBtn.style.display = 'flex';
        }
      }

      if (itemObj) {
        document.getElementById('modalItem').value = itemObj.item || '';
        document.getElementById('modalBuy').value = itemObj.buyPrice !== undefined ? itemObj.buyPrice : (itemObj.amount || '');
        document.getElementById('modalSell').value = itemObj.sellPrice !== undefined ? itemObj.sellPrice : (itemObj.paid || '');
        document.getElementById('modalSerial').value = itemObj.serial || '';
        serialLabel.innerText = 'السيريال:';
      }

      modal.style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('controlModal').style.display = 'none';
      activeDeviceIndex = null;
    }

    function executeAction(actionType) {
      if (activeDeviceIndex === null) return;

      if (actionType === 'delete') {
        if (confirm('هل أنت متأكد من حذف هذا العنصر نهائياً؟')) {
          if (activeContext === 'purchases') devicesData.splice(activeDeviceIndex, 1), localStorage.setItem('devicesDataList', JSON.stringify(devicesData)), renderDevicesTable();
          else if (activeContext === 'sales') salesData.splice(activeDeviceIndex, 1), localStorage.setItem('salesDataList', JSON.stringify(salesData)), renderSalesTable();
          else if (activeContext === 'accPurchases') accPurchasesData.splice(activeDeviceIndex, 1), localStorage.setItem('accPurchasesDataList', JSON.stringify(accPurchasesData)), renderAccPurchasesTable();
          else if (activeContext === 'accSales') accSalesData.splice(activeDeviceIndex, 1), localStorage.setItem('accSalesDataList', JSON.stringify(accSalesData)), renderAccSalesTable();
          else if (activeContext === 'maintenance') maintenanceData.splice(activeDeviceIndex, 1), localStorage.setItem('maintenanceDataList', JSON.stringify(maintenanceData)), renderMaintenanceTable();
          else if (activeContext === 'salesNotebook') salesNotebookData.splice(activeDeviceIndex, 1), localStorage.setItem('salesNotebookDataList', JSON.stringify(salesNotebookData)), renderSalesNotebookTable();
          
          syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
          closeModal();
          alert('تم الحذف بنجاح!');
        }
      } else if (actionType === 'transfer') {
        if (activeContext === 'purchases') {
          const item = devicesData.splice(activeDeviceIndex, 1)[0];
          salesData.push(item);
          localStorage.setItem('devicesDataList', JSON.stringify(devicesData));
          localStorage.setItem('salesDataList', JSON.stringify(salesData));
          renderDevicesTable();
          renderSalesTable();
          closeModal();
          syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
          alert('تم ترحيل العنصر إلى قائمة المبيعات بنجاح!');
        } else if (activeContext === 'sales') {
          const item = salesData.splice(activeDeviceIndex, 1)[0];
          devicesData.push(item);
          localStorage.setItem('salesDataList', JSON.stringify(salesData));
          localStorage.setItem('devicesDataList', JSON.stringify(devicesData));
          renderSalesTable();
          renderDevicesTable();
          closeModal();
          syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
          alert('تم ترحيل العنصر إلى قائمة المشتريات بنجاح!');
        } else if (activeContext === 'accPurchases') {
          const item = accPurchasesData.splice(activeDeviceIndex, 1)[0];
          accSalesData.push(item);
          localStorage.setItem('accPurchasesDataList', JSON.stringify(accPurchasesData));
          localStorage.setItem('accSalesDataList', JSON.stringify(accSalesData));
          renderAccPurchasesTable();
          renderAccSalesTable();
          closeModal();
          syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
          alert('تم ترحيل الإكسسوار إلى قائمة المبيعات بنجاح!');
        } else if (activeContext === 'accSales') {
          const item = accSalesData.splice(activeDeviceIndex, 1)[0];
          accPurchasesData.push(item);
          localStorage.setItem('accSalesDataList', JSON.stringify(accSalesData));
          localStorage.setItem('accPurchasesDataList', JSON.stringify(accPurchasesData));
          renderAccSalesTable();
          renderAccPurchasesTable();
          closeModal();
          syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
          alert('تم ترحيل الإكسسوار إلى قائمة المشتريات بنجاح!');
        }
      }
    }

    function saveModalChanges() {
      if (activeDeviceIndex === null) return;

      const newName = document.getElementById('modalItem').value;
      const newBuy = parseFloat(document.getElementById('modalBuy').value) || 0;
      const newSell = parseFloat(document.getElementById('modalSell').value) || 0;
      const newSerial = document.getElementById('modalSerial').value;

      if (activeContext === 'purchases') {
        devicesData[activeDeviceIndex].item = newName;
        devicesData[activeDeviceIndex].buyPrice = newBuy;
        devicesData[activeDeviceIndex].sellPrice = newSell;
        devicesData[activeDeviceIndex].serial = newSerial;
        localStorage.setItem('devicesDataList', JSON.stringify(devicesData));
        renderDevicesTable();
      } else if (activeContext === 'sales') {
        salesData[activeDeviceIndex].item = newName;
        salesData[activeDeviceIndex].buyPrice = newBuy;
        salesData[activeDeviceIndex].sellPrice = newSell;
        salesData[activeDeviceIndex].serial = newSerial;
        localStorage.setItem('salesDataList', JSON.stringify(salesData));
        renderSalesTable();
      } else if (activeContext === 'accPurchases') {
        accPurchasesData[activeDeviceIndex].item = newName;
        accPurchasesData[activeDeviceIndex].buyPrice = newBuy;
        accPurchasesData[activeDeviceIndex].sellPrice = newSell;
        accPurchasesData[activeDeviceIndex].serial = newSerial;
        localStorage.setItem('accPurchasesDataList', JSON.stringify(accPurchasesData));
        renderAccPurchasesTable();
      } else if (activeContext === 'accSales') {
        accSalesData[activeDeviceIndex].item = newName;
        accSalesData[activeDeviceIndex].buyPrice = newBuy;
        accSalesData[activeDeviceIndex].sellPrice = newSell;
        accSalesData[activeDeviceIndex].serial = newSerial;
        localStorage.setItem('accSalesDataList', JSON.stringify(accSalesData));
        renderAccSalesTable();
      } else if (activeContext === 'maintenance') {
        maintenanceData[activeDeviceIndex].item = newName;
        maintenanceData[activeDeviceIndex].buyPrice = newBuy;
        maintenanceData[activeDeviceIndex].sellPrice = newSell;
        maintenanceData[activeDeviceIndex].serial = newSerial;
        maintenanceData[activeDeviceIndex].status = document.getElementById('modalMaintStatus').value;
        maintenanceData[activeDeviceIndex].paidPrice = parseFloat(document.getElementById('modalPaid').value) || 0;
        maintenanceData[activeDeviceIndex].remainingPrice = parseFloat(document.getElementById('modalRemaining').value) || 0;
        localStorage.setItem('maintenanceDataList', JSON.stringify(maintenanceData));
        renderMaintenanceTable();
      } else if (activeContext === 'salesNotebook') {
        salesNotebookData[activeDeviceIndex].item = newName;
        salesNotebookData[activeDeviceIndex].amount = newBuy;
        salesNotebookData[activeDeviceIndex].paid = newSell;
        salesNotebookData[activeDeviceIndex].remaining = Math.max(0, newBuy - newSell);
        salesNotebookData[activeDeviceIndex].customerName = document.getElementById('modalCustomerName').value;
        salesNotebookData[activeDeviceIndex].customerPhone = document.getElementById('modalCustomerPhone').value;
        localStorage.setItem('salesNotebookDataList', JSON.stringify(salesNotebookData));
        renderSalesNotebookTable();
      }

      syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
      closeModal();
      showToast('تم حفظ التعديلات بنجاح!');
    }

    function openExpenseEditModal(index) {
      activeExpenseIndex = index;
      const exp = expensesData[index];
      document.getElementById('editExpenseStatement').value = exp.statement;
      document.getElementById('editExpenseAmount').value = exp.amount;
      document.getElementById('expenseEditModal').style.display = 'flex';
    }

    function closeExpenseModal() {
      document.getElementById('expenseEditModal').style.display = 'none';
      activeExpenseIndex = null;
    }

    function saveExpenseModalChanges() {
      if (activeExpenseIndex === null) return;
      expensesData[activeExpenseIndex].statement = document.getElementById('editExpenseStatement').value;
      expensesData[activeExpenseIndex].amount = parseFloat(document.getElementById('editExpenseAmount').value) || 0;
      localStorage.setItem('expensesDataList', JSON.stringify(expensesData));
      renderExpensesTable();
      syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
      closeExpenseModal();
      showToast('تم تعديل المصروف بنجاح!');
    }

    function deleteExpense(index) {
      if (confirm('هل أنت متأكد من حذف هذا المصروف؟')) {
        expensesData.splice(index, 1);
        localStorage.setItem('expensesDataList', JSON.stringify(expensesData));
        renderExpensesTable();
        syncChannel.postMessage({ type: 'SYNC_SUCCESS' });
        showToast('تم حذف المصروف بنجاح!');
      }
    }
  </script>
</body>
